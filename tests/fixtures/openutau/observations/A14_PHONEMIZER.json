  "observed": {
    "summary": "Phonemizer state transitions: after MIDI import OpenUtau.Core.DefaultPhonemizer (OpenUtau's application default, nothing from the MIDI); after selecting the singer on a track it stayed OpenUtau.Core.DefaultPhonemizer (this voicebank's character.yaml defines no default phonemizer, so none was voicebank-provided); no manual phonemizer selection was needed for synthesis, because all four tracks rendered audio with the default. The state is stored per track and survived save and reopen. The track menu offers language-grouped built-in phonemizers (for example FR: CVVC, CMUSphinx, VCCV; EN: ARPA, ARPA+, others); none was selected.",
    "events": [
      {
        "state": "after import",
        "phonemizer": "OpenUtau.Core.DefaultPhonemizer",
        "origin": "OpenUtau application default"
      },
      {
        "state": "after singer selection",
        "phonemizer": "OpenUtau.Core.DefaultPhonemizer",
        "origin": "unchanged (voicebank defines none)"
      },
      {
        "state": "render with default",
        "result": "audio produced on all four tracks"
      }
    ]
  },

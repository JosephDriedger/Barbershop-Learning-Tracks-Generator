  "observed": {
    "summary": "Before any singer was installed, plain import stored no singer. After installing ALYS DB002 FRA through Tools > Install Singer, a fresh File > Open of the same MIDI again stored no singer (track shows 'Select Singer'): merely having a singer installed does not change import defaults. Selecting the singer on the Tenor track only stored singer 'alys-db-002-fra' at track level (the installed folder name, not a path) and set that track's renderer to WORLDLINE-R automatically; the other three tracks were unchanged, and the phonemizer stayed DefaultPhonemizer. The Tenor selection persisted through save and reopen. The singer was then assigned track by track to all four tracks.",
    "events": [
      {
        "state": "import before install",
        "singer": "none"
      },
      {
        "state": "import after install",
        "singer": "none"
      },
      {
        "state": "after selecting on Tenor",
        "tenor_singer": "alys-db-002-fra",
        "other_tracks_singer": "none"
      },
      {
        "state": "after save and reopen",
        "tenor_singer": "alys-db-002-fra",
        "renderer": "WORLDLINE-R"
      }
    ]
  },
